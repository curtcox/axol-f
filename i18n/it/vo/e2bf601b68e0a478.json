{"line":"T64.C.03","text":"Il decollo rapido significa un anno o due, spinto soprattutto dal software: algoritmi migliori, molte copie, e IA che fa ricerca sull’IA. Questo mi sembra molto più plausibile, forse fra il 25 e il 35% in questo decennio. Visto dall’interno, niente somiglia a un’esplosione. Si ha solo l’impressione che ogni mese sia più strano del precedente.","lufs":-20.36,"alignment":{"characters":["I","l"," ","d","e","c","o","l","l","o"," ","r","a","p","i","d","o"," ","s","i","g","n","i","f","i","c","a"," ","u","n"," ","a","n","n","o"," ","o"," ","d","u","e",","," ","s","p","i","n","t","o"," ","s","o","p","r","a","t","t","u","t","t","o"," ","d","a","l"," ","s","o","f","t","w","a","r","e",":"," ","a","l","g","o","r","i","t","m","i"," ","m","i","g","l","i","o","r","i",","," ","m","o","l","t","e"," ","c","o","p","i","e",","," ","e"," ","I","A"," ","c","h","e"," ","f","a"," ","r","i","c","e","r","c","a"," ","s","u","l","l","’","I","A","."," ","Q","u","e","s","t","o"," ","m","i"," ","s","e","m","b","r","a"," ","m","o","l","t","o"," ","p","i","ù"," ","p","l","a","u","s","i","b","i","l","e",","," ","f","o","r","s","e"," ","f","r","a"," ","i","l"," ","2","5"," ","e"," ","i","l"," ","3","5","%"," ","i","n"," ","q","u","e","s","t","o"," ","d","e","c","e","n","n","i","o","."," ","V","i","s","t","o"," ","d","a","l","l","’","i","n","t","e","r","n","o",","," ","n","i","e","n","t","e"," ","s","o","m","i","g","l","i","a"," ","a"," ","u","n","’","e","s","p","l","o","s","i","o","n","e","."," ","S","i"," ","h","a"," ","s","o","l","o"," ","l","’","i","m","p","r","e","s","s","i","o","n","e"," ","c","h","e"," ","o","g","n","i"," ","m","e","s","e"," ","s","i","a"," ","p","i","ù"," ","s","t","r","a","n","o"," ","d","e","l"," ","p","r","e","c","e","d","e","n","t","e","."],"character_start_times_seconds":[0,0.08,0.16,0.2,0.24,0.28,0.32,0.4,0.48,0.56,0.64,0.72,0.8,0.88,0.96,1.067,1.173,1.28,1.336,1.392,1.448,1.504,1.56,1.616,1.672,1.728,1.784,1.84,1.947,2.053,2.16,2.224,2.288,2.3